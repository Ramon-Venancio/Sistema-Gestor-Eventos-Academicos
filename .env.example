# Copie este arquivo para ".env" e preencha com os seus dados locais:
# cp .env.example .env

# Em desenvolvimento local use True; em produção (Render) use False
DEBUG=True

# Para gerar uma chave segura no terminal:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole_aqui_sua_chave

# Domínios permitidos separados por vírgula
ALLOWED_HOSTS=127.0.0.1,localhost

# String de conexão do seu PostgreSQL local ou do seu próprio banco no Neon
DATABASE_URL=postgresql://usuario:senha@localhost:5432/eventos_db